{
  "name": "project-tasks",
  "productName": "TiM",
  "version": "0.1.4",
  "description": "Кроссплатформенный менеджер проектов и задач",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "build": {
    "appId": "com.inzhevatkin.projecttasks",
    "artifactName": "TiM-setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "inzhevatkin",
        "repo": "project-tasks"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "ru_RU",
        "en_US",
        "zh_CN"
      ]
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  },
  "type": "module",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
